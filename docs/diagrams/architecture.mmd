flowchart TD
    web["Next.js web app"] --> api["Python / FastAPI"]
    api --> research["Budgeted research workers"]
    research --> evidence["Evidence and claims"]
    research -.-> providers["Provider adapters"]
    evidence --> gate{"Debate?"}
    gate -->|Yes| debate["Bounded challenge and rebuttal"]
    gate -->|No| verify["Synthesis and citation checks"]
    debate --> verify
    verify --> output["Cited answer and run events"]
    classDef stage fill:#eff6ff,stroke:#2563eb,color:#172554;
    classDef decision fill:#fffbeb,stroke:#d97706,color:#78350f;
    classDef result fill:#ecfdf5,stroke:#059669,color:#064e3b;
    class web,api,research,evidence,providers,debate,verify stage;
    class gate decision;
    class output result;
