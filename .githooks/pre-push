#!/bin/sh
set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$remote_ref" in
    refs/heads/main)
      echo "direct pushes to main are blocked; merge an approved pull request" >&2
      exit 1
      ;;
    refs/heads/codex/*)
      ;;
    refs/tags/*)
      echo "tag pushes require the approved release workflow" >&2
      exit 1
      ;;
    refs/heads/*)
      echo "branch push rejected; use codex/<type>-<topic>" >&2
      exit 1
      ;;
  esac
done

exit 0
